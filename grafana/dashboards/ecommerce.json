{
  "uid": "ecommerce-live",
  "title": "E-commerce live revenue",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Total revenue",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg248zg8pd4aof"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT SUM(revenue) AS revenue FROM revenue_per_category WHERE $__timeFilter(window_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg248zg8pd4aof"
      }
    },
    {
      "type": "stat",
      "title": "Units sold",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg248zg8pd4aof"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT SUM(units_sold) AS units FROM revenue_per_category WHERE $__timeFilter(window_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg248zg8pd4aof"
      }
    },
    {
      "type": "barchart",
      "title": "Revenue by category (selected range)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg248zg8pd4aof"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT category, SUM(revenue) AS revenue FROM revenue_per_category WHERE $__timeFilter(window_start) GROUP BY category ORDER BY revenue DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg248zg8pd4aof"
      }
    },
    {
      "type": "table",
      "title": "Latest closed minute",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg248zg8pd4aof"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT category, units_sold, revenue FROM revenue_per_category WHERE window_start = (SELECT MAX(window_start) FROM revenue_per_category) ORDER BY revenue DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg248zg8pd4aof"
      }
    },
    {
      "type": "timeseries",
      "title": "Revenue per category per minute",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg248zg8pd4aof"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, category, revenue FROM revenue_per_category WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.category}",
          "custom": {
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg248zg8pd4aof"
      }
    },
    {
      "type": "timeseries",
      "title": "Units sold per minute (stacked)",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg248zg8pd4aof"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, category, units_sold FROM revenue_per_category WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.category}",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg248zg8pd4aof"
      }
    }
  ]
}